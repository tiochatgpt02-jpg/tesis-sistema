# Copia este archivo como .env y ajusta tus credenciales PostgreSQL

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=sistema_ia

# false = conexión real a PostgreSQL | true = datos de demostración sin BD
USE_MOCK_DATA=false

# En hosting: URL PostgreSQL con sslmode=require; reemplaza POSTGRES_*.
DATABASE_URL=
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
AI_TIMEOUT_SECONDS=25
AI_MAX_OUTPUT_TOKENS=3000

SECRET_KEY=cambia-esta-clave-secreta

# Opcional: generación de contenido con OpenAI
OPENAI_API_KEY=

# Ollama (IA local para juegos)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# Opcional: enviar SMS reales con Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
